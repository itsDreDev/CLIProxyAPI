{
  "name": "subscription-desk-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "prepare:proxy": "node ../scripts/prepare-desktop.mjs",
    "desktop:dev": "npm run prepare:proxy && tauri dev",
    "desktop:build": "npm run prepare:proxy && tauri build",
    "test:e2e": "playwright test",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "@playwright/test": "1.64.0"
  }
}
