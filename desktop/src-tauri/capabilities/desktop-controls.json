{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-controls",
  "description": "Only the bundled controls window can manage the app-owned proxy. Dashboard windows have no native capabilities.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-status",
    "allow-start-proxy",
    "allow-stop-proxy",
    "allow-use-local",
    "allow-connect-remote",
    "allow-open-dashboard",
    "allow-copy-management-key"
  ]
}
